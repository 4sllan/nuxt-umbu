{
  // 1. Estenda a configuração que o Nuxt gera para o playground
  "extends": "./.nuxt/tsconfig.json",

  "compilerOptions": {
    "baseUrl": "..", // Referência à raiz a partir da pasta playground
    "skipLibCheck": true,
    "paths": {
      // Use os aliases que o Nuxt espera ou os seus customizados
      "#auth-utils/*": ["../src/runtime/sanctum/utils/*", "../src/runtime/passport/utils/*"],
      "#auth-types": ["../src/runtime/types/index.ts"]
    }
  },
  "include": [
    "./**/*",             // Inclui os arquivos do playground
    "../src/**/*",        // Inclui o código do seu módulo
    "../.nuxt/nuxt.d.ts"  // Garante que o TS veja os tipos globais do Nuxt
  ],
  "exclude": [
    "../dist",
    "../node_modules"
  ]
}