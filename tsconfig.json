{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,

    "lib": ["ESNext", "DOM"],

    "jsx": "preserve",
    "resolveJsonModule": true,

    "baseUrl": ".",
    "paths": {
      "#runtime/*": ["src/runtime/*"],
      "#types/*": ["src/runtime/types/*"]
    },

    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test", "playground", "node_modules"]
}
